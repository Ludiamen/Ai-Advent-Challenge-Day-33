# Скопируйте этот файл в .env и впишите свои ключи:
#   cp  .env.example .env
#
# .env добавлен в .gitignore и в репозиторий не попадёт.
# Проверить, что ключи видны:            python cli.py --роли
# Проверить, что модели ещё существуют:  python cli.py --проверить

# --- ключи провайдеров -------------------------------------------------------
# Каждая модель знает, из какой переменной брать ключ (см. agent/catalog.py).
# Нужен не каждый: модели без ключа просто не используются, а роль подбирает
# следующую доступную модель из своего списка.

# Groq — бесплатный тариф, на нём работает почти всё: gpt-oss-120b (основные
# ответы и планирование), gpt-oss-20b (свёртка задач), allam-2-7b
# (маршрутизация реплик и мягкая проверка стиля).
# Ключ: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# z.ai (GLM) — бесплатная glm-4.5-flash. Нужна не ради качества, а ради лимитов:
# частые мелкие вызовы чередуются между Groq и z.ai, чтобы не упираться в
# минутный лимит одного провайдера.
# Ключ: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# DeepSeek — платный. Используется только как верхняя ступень эскалации, когда
# бесплатная модель дважды не уложилась в инварианты.
# Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- модель ------------------------------------------------------------------
# Пусто — модель выбирается по роли (планирование и исполнение разведены).
# Непустое значение фиксирует одну модель на все точки вызова.
LLM_MODEL_KEY=

# Низкая температура: агент должен быть предсказуем, а не изобретателен.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# --- где лежит память --------------------------------------------------------
# Внутри этого каталога создаются:
#   dialog.db                   краткосрочная память (SQLite)
#   working/<задача>.json       рабочая память, по файлу на задачу
#   long/<кто>/profile.json     предпочтения пользователя и инварианты проекта
#   long/<кто>/scenarios.json   «на такой запрос — такие агенты в таком порядке»
#   long/<кто>/decisions.jsonl  журнал принятых решений
#   long/<кто>/knowledge.json   факты о системе
#   routing.jsonl               журнал «что и почему куда записалось»
#
# У каждого «--кто» свой каталог в «long»: профиль, сценарии и знания не
# пересекаются. Пользователь, названный как заготовка (инженер, тимлид,
# новичок, менеджер), получает её предпочтения сам; остальные начинают с
# умолчаний, и агент предлагает пройти мастер настройки.
MEMORY_DIR=memory

# --- MCP (День 16) -----------------------------------------------------------
# Токен для удалённого MCP-сервера GitHub (см. mcp-servers.json: там стоит ссылка
# ${GITHUB_TOKEN}, а не сам токен). Без него сервер github помечен «не готов» и
# пропускается — остальные серверы работают.
# Fine-grained token, только чтение: https://github.com/settings/personal-access-tokens
# Значение — латиницей: HTTP-заголовки не допускают кириллицу.
GITHUB_TOKEN=

# --- Трекер задач (День 17) ---------------------------------------------------
# День 17 поднимает свой MCP-сервер вокруг API трекера. По умолчанию он ходит в
# мок из репозитория (tracker_api.py) — для него ничего задавать не нужно:
#   python tracker_api.py            # в отдельном терминале
#   python cli.py --инструменты tracker "Что в работе по переносу?"
#
# Чтобы тот же сервер работал с настоящим Яндекс.Трекером (сервер «tracker-real»
# в mcp-servers.json), нужны OAuth-токен и идентификатор организации:
#   токен       https://yandex.ru/dev/tracker/ru/concepts/access
#   организация в интерфейсе Трекера: «Администрирование» → идентификатор
TRACKER_TOKEN=
TRACKER_ORG=
# Заголовок организации: X-Cloud-Org-ID (Яндекс Облако) или X-Org-ID (Яндекс 360).
TRACKER_ORG_HEADER=X-Cloud-Org-ID
# Очередь, в которой искать по умолчанию.
TRACKER_QUEUE=TRACKER
# Меняющие инструменты у настоящего Трекера выключены, пока здесь не 1.
# Тогда модель сможет предлагать комментарии и смену статусов — каждый такой
# вызов всё равно требует подтверждения человеком.
TRACKER_WRITE=0

# --- Планировщик (День 18) ----------------------------------------------------
# Где лежит база планировщика: задания, история запусков, сводки, напоминания.
# По умолчанию — scheduler.db внутри MEMORY_DIR, и менять это не нужно: важно
# только, чтобы агент, MCP-сервер планировщика и работник смотрели в один файл.
# Задавайте, если хотите держать расписание отдельно от остальной памяти:
#   SCHEDULER_DB=/var/lib/агент/scheduler.db
SCHEDULER_DB=
#
# Выполняет задания отдельный процесс — без него они просто ждут:
#   python worker.py                 # работать, пока не остановят
#   python worker.py --состояние     # что в расписании, ничего не выполняя
# Текст сводок работник пишет моделью роли «сжатие»; ключ берётся отсюда же.
# Не нужен текст — запускайте с «--без-модели», останутся цифры.

# --- Конвейеры инструментов (День 19) -----------------------------------------
# Где лежат описания цепочек. По умолчанию — pipelines.json рядом с
# mcp-servers.json; путь важен тем, что его читают двое: сервер конвейеров
# (через «env» в mcp-servers.json) и сам агент, когда решает, нужна ли заявка.
#   PIPELINES_FILE=/opt/агент/pipelines.json
PIPELINES_FILE=
#
# Куда конвейер кладёт отчёты. По умолчанию — reports/ в каталоге дня. Каталог
# задаёт сервер, а не вызывающий: имя файла приходит от модели, и выход за этот
# каталог невозможен по построению.
REPORTS_DIR=
#
# Какой моделью шаг summarize пишет выжимку. Пусто — модель роли «сжатие» из
# каталога; «нет» — не звать модель вовсе (выжимка соберётся по правилам, это
# удобно в тестах и при отсутствии ключей).
PIPELINE_MODEL=
#
# Проверить цепочки:
#   python cli.py --конвейеры          какие описаны
#   python cli.py --конвейер отчёт     выполнить целиком
#   python cli.py --прогон 1           что во что передалось

# --- Оркестровка серверов (День 20) -------------------------------------------
# Правила порядка вызовов для длинного флоу: «комментарий — только после чтения
# задачи», «отчёт — только после выжимки». По умолчанию — flow-rules.json рядом
# с mcp-servers.json; нет файла — работают те же правила, встроенные в
# agent/orchestra/order.py.
#   FLOW_RULES=/opt/агент/flow-rules.json
FLOW_RULES=
#
# Маршрут запроса (какие серверы поднимать) считает дешёвая модель роли
# «выбор-серверов» из agent/catalog.py; ключ берётся оттуда же. Модель молчит
# или недоступна — маршрут собирается правилами по полю «темы» в
# mcp-servers.json, и без инструментов агент не остаётся.
#
# Проверить:
#   python cli.py --маршрут «Что по MIG-2 и что пишет документация?»
#   python cli.py --инструменты --флоу «Разбери MIG-2 и сделай отчёт»
#   python cli.py --флоу-показать 1     план, вызовы, сверка
#   python cli.py --без-маршрутизации … отдать модели все серверы, как до Дня 20

# --- показ в браузере (День 20) -----------------------------------------------
# Секрет демонстрационного стенда. Пусто — страница открыта, как и была: это
# местный сервер на 127.0.0.1. Непустое значение включает ворота: адрес нужно
# открыть с «?key=…», дальше работает кука. Нужно, когда стенд выносят наружу
# туннелем, чтобы его увидело браузерное расширение (см. DEMO-CHROME.md):
# наружу вместе со страницей уезжают ключи провайдера и доступ к чужим системам.
# Скрипт demo_stand.sh --tunnel придумывает секрет сам и печатает готовый адрес.
DEMO_KEY=

# --- Локальная модель, Ollama (День 26) ---------------------------------------
# Локальные модели каталога (loc-…) ходят в Ollama на этой машине: ключ не
# нужен, цена 0. Установка и модели:
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull qwen3.5:4b qwen3:4b qwen3:1.7b gemma3:4b phi4-mini
# Адрес Ollama — та же переменная, что понимает сама ollama; схему можно не писать.
OLLAMA_HOST=127.0.0.1:11434
# Окно контекста на запрос. У Ollama по умолчанию 4096, и лишнее она обрезает
# молча; RAG-промпт Дня 24 — 3–6 тысяч токенов. Больше окно — больше памяти.
OLLAMA_NUM_CTX=8192
# Сколько модель держится в памяти после ответа: загрузка 4B на CPU — около 20 с.
OLLAMA_KEEP_ALIVE=30m
# Тайм-аут локального вызова, секунд: на CPU без видеокарты длинный промпт
# читается минутами.
LLM_LOCAL_TIMEOUT=1800
# Основная локальная модель (её пишет замер) и задачи замера. Пусто —
# local-settings.json и local-tasks.json рядом с cli.py.
#   LOCAL_SETTINGS=/opt/агент/local-settings.json
#   LOCAL_TASKS=/opt/агент/local-tasks.json
#
# Проверить:
#   python cli.py --ollama                     служба, адрес, модели, память
#   python cli.py --локально «…» --рядом       локально и в облако рядом
#   python cli.py --бенчмарк-локально          замер → LOCAL-BENCH.md

# --- День 30: Telegram-бот (SERVICE.md, «Telegram-бот») ---
# Токен — от @BotFather; ID владельца — единственный, кому бот отвечает
# (узнать: python cli.py --телеграм-кто при остановленном боте).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=

# --- День 31: ассистент разработчика (/help о проекте) ---------------------------------
# Проекты — projects.json; путь проекта можно переопределить: PROJECT_<ИМЯ>_DIR
# (имя заглавными). Проект подключается только на чтение.
#PROJECT_CRM_DIR=/home/<пользователь>/Документы/CRM
# Другой файл проектов (по умолчанию projects.json в корне дня):
#PROJECTS_FILE=
# Облачная модель ассистента — ds-flash (DEEPSEEK_API_KEY выше); в сервисе её хост
# (api.deepseek.com) разрешается процессу автоматически из service.json → «проект».

# --- День 32: AI-ревью PR (specs/032-code-review) -----------------------------------
# Токен владельца для локального `python review.py --pr N` и пробных веток: fine-grained PAT
# только на репозиторий Дня 32 (Contents RW, Pull requests RW, Workflows RW, Actions R).
# В GitHub Actions он не нужен — там свой GITHUB_TOKEN задания.
# GITHUB_PAT=
# В Secrets репозитория (Settings → Secrets and variables → Actions), не в этот файл:
#   DEEPSEEK_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (= значение TELEGRAM_OWNER_ID).
# Способ поиска опоры ревью: «лексический» (BM25, по умолчанию) или «bge-m3».
# REVIEW_SEARCH=лексический
